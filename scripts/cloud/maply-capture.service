[Unit]
Description=Maply cloud capture supervisor
Requires=maply-desktop.service maply-app.service
After=maply-desktop.service maply-app.service

[Service]
User=maply
Group=maply
WorkingDirectory=/opt/maply/backend
Environment=HOME=/home/maply
Environment=DISPLAY=:99
Environment=XAUTHORITY=/home/maply/.Xauthority
ExecStart=/opt/maply/backend/.venv/bin/python /opt/maply/scripts/cloud/supervisor.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
