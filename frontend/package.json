{
  "name": "maply",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Plan, capture and tag Street View photos with OpenRouter. Local only; fonts bundled.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:visualiser": "node tests/visualiser.mjs",
    "test:atlas-data": "node --experimental-strip-types --test tests/atlas-data.mjs",
    "test:review": "node tests/review-workspace.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
