# Optional. Copy to .env to change anything; maply works without it.

# Browser used for native desktop capture.
BROWSER_APP=Google Chrome

# Planning map tiles. Respect the provider's usage policy (OSM: light use only).
BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Ports and database password (docker compose).
APP_PORT=8000
DB_PORT=5433
POSTGRES_PASSWORD=maply
