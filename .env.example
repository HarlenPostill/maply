# maply configuration. Copy to `.env` and adjust. Never commit `.env` (it is gitignored).
# Every value here has a safe default; nothing is required for synthetic development.

# ---------------------------------------------------------------------------
# Processing boundary (see docs/DATA_BOUNDARIES.md)
# ---------------------------------------------------------------------------
# Master switch. false = no screenshot or image-bearing payload is ever sent to
# a model provider, from any adapter or logging path. Projects must ALSO opt in
# (Settings tab: allow third-party processing + list "openai").
ALLOW_CLOUD_IMAGE_PROCESSING=false
# Synthetic mock imagery is not research data. Enable only to exercise the
# OpenAI adapter against the local mock site.
ALLOW_SYNTHETIC_CLOUD_IMAGE_PROCESSING=false

# ---------------------------------------------------------------------------
# OpenAI computer-use adapter (optional)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# A model whose docs page lists the computer tool (e.g. gpt-6.1-sol as of 2026-10).
# Access is verified at worker startup with models.retrieve (no images sent).
OPENAI_COMPUTER_USE_MODEL=
OPENAI_COMPUTER_TOOL_TYPE=computer
# Request-level data control; NOT a zero-retention guarantee.
OPENAI_STORE=false
# off | models (free access check) | probe (one tiny text-only Responses call)
OPENAI_STARTUP_CHECK=models
OPENAI_MAX_MODEL_CALLS_PER_TASK=12
OPENAI_MAX_ACTIONS_PER_TASK=30
# USD per 1M tokens, for ESTIMATES only. Check the current pricing page for your model.
OPENAI_PRICE_INPUT_PER_MTOK=2.00
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=0.10
OPENAI_PRICE_OUTPUT_PER_MTOK=10.00
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Google Street View Static API (optional, official interface)
# Only used if the project permits method "streetview_static_api".
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=
STATIC_API_MAX_SIZE=640

# ---------------------------------------------------------------------------
# Operator-level ceilings (projects can only narrow these)
# ---------------------------------------------------------------------------
PERMITTED_ACCESS_METHODS=deterministic_browser,manual,openai_agent
PERMITTED_TARGETS=synthetic,google_maps
MAX_WORKERS=4
MAX_REQUESTS_PER_MINUTE=20
MAX_CAPTURES_PER_JOB=2000
# Approved geographic boundary. The shipped file is an APPROXIMATION; replace it
# with the official City of Sydney LGA boundary before live collection.
# SCOPE_GEOJSON_PATH=/app/config/city_of_sydney_approx.geojson

# ---------------------------------------------------------------------------
# Worker runtime
# ---------------------------------------------------------------------------
WORKER_HEADLESS=true
LEASE_SECONDS=60
HEARTBEAT_SECONDS=10
STALLED_AFTER_SECONDS=45
RETRY_BACKOFF_BASE_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=120

# ---------------------------------------------------------------------------
# Synthetic mock panorama site (development/tests)
# ---------------------------------------------------------------------------
ENABLE_MOCK_PANORAMA=true
MOCK_FAULT_RATE=0.06

# ---------------------------------------------------------------------------
# Planning basemap (dashboard). Respect the tile provider's licence and usage
# policy; the OSM default is for light interactive use only. Set to "none" to disable.
# ---------------------------------------------------------------------------
BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors
BASEMAP_MAX_ZOOM=19

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=maply
APP_PORT=8000
DB_PORT=5433
# postgis/postgis is amd64-only (emulated on Apple Silicon). Multi-arch alternative:
# POSTGIS_IMAGE=imresamu/postgis:16-3.4
